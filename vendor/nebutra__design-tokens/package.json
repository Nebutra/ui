{
  "name": "@nebutra/design-tokens",
  "version": "0.1.2",
  "description": "W3C DTCG ($value/$type) tokens — SSOT, Style Dictionary 4 pipeline. Coexists with @nebutra/tokens; not a replacement.",
  "license": "MIT",
  "type": "module",
  "main": "./build/ts/index.js",
  "types": "./build/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/ts/index.d.ts",
      "import": "./build/ts/index.js"
    },
    "./tokens/core.json": "./tokens/core.json",
    "./tokens/semantic.json": "./tokens/semantic.json",
    "./tokens/themes/light.json": "./tokens/themes/light.json",
    "./tokens/themes/dark.json": "./tokens/themes/dark.json",
    "./scripts/css-var-name.mjs": {
      "types": "./scripts/css-var-name.d.mts",
      "default": "./scripts/css-var-name.mjs"
    },
    "./scripts/derive-border-tier.mjs": {
      "types": "./scripts/derive-border-tier.d.mts",
      "default": "./scripts/derive-border-tier.mjs"
    },
    "./themes": {
      "types": "./themes.ts",
      "import": "./themes.ts"
    },
    "./build/css/styles.generated.css": "./build/css/styles.generated.css"
  },
  "files": [
    "build",
    "tokens",
    "scripts/css-var-name.mjs",
    "scripts/css-var-name.d.mts",
    "scripts/derive-border-tier.mjs",
    "scripts/derive-border-tier.d.mts",
    "themes.ts",
    "style-dictionary.config.mjs"
  ],
  "dependencies": {},
  "private": false
}
