{
  "name": "@nebutra/brand",
  "version": "0.1.2",
  "description": "Nebutra brand assets, logos, and identity components",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./logo": {
      "types": "./dist/components/Logo.d.ts",
      "import": "./dist/components/Logo.js",
      "default": "./dist/components/Logo.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./metadata-helpers": {
      "types": "./dist/metadata-helpers.d.ts",
      "import": "./dist/metadata-helpers.js",
      "default": "./dist/metadata-helpers.js"
    },
    "./microcopy": {
      "types": "./dist/microcopy.d.ts",
      "import": "./dist/microcopy.js",
      "default": "./dist/microcopy.js"
    },
    "./og": {
      "types": "./dist/og/index.d.ts",
      "import": "./dist/og/index.js",
      "default": "./dist/og/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "dependencies": {
    "react": "^19.2.4"
  },
  "private": false
}
