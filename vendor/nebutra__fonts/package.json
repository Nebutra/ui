{
  "name": "@nebutra/fonts",
  "version": "4.0.1",
  "description": "Self-hosted OSS font registry — build-time next/font faces + a name→CSS-var resolver so theme / DESIGN.md fonts render with zero runtime external requests",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next": {
      "types": "./src/next.ts",
      "import": "./src/next.ts",
      "default": "./src/next.ts"
    },
    "./next/cjk": {
      "types": "./src/next-cjk.ts",
      "import": "./src/next-cjk.ts",
      "default": "./src/next-cjk.ts"
    },
    "./font-face": {
      "types": "./src/cjk-font-face.tsx",
      "import": "./src/cjk-font-face.tsx",
      "default": "./src/cjk-font-face.tsx"
    },
    "./cjk": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js",
      "default": "./dist/generated/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "generated/subset-manifest.json",
    "generated/index.ts",
    "generated/dm-sans.woff2",
    "generated/registry",
    "vendor/misans/LICENSE.txt",
    "vendor/dm-sans/OFL.txt",
    "NOTICE-FONTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@nebutra/brand": "file:../nebutra__brand"
  },
  "private": false
}
